--- a/src/mono/mono/mini/mini.c	2026-05-05 20:53:28.943630411 -0400
+++ b/src/mono/mono/mini/mini.c	2026-05-05 20:53:28.994766856 -0400
@@ -4359,7 +4359,11 @@
